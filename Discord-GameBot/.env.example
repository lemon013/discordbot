DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
# テスト用サーバーID（任意）。設定するとコマンド反映が速くなります。
TEST_GUILD_ID=

# Gemini AI chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Player data directory outside the source checkout. On MWS, set this to
# the persistent volume supplied by your host. Default: ~/.discord-gamebot
# BOT_DATA_DIR=/your/persistent/volume/gamebot
